<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.manedsoftware.wolphun">

    <!-- ler ROMs de uma pasta compartilhada (/sdcard/mophun) que sobrevive a reinstalações -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- gravar as capturas de tela em /sdcard/Pictures/wolphun. Do Android 10 (29) em diante
         isso passa pelo MediaStore e NAO precisa de permissao nenhuma -> maxSdkVersion. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/wolphun_logo"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@drawable/wolphun_logo"
        android:theme="@style/AppTheme">

        <activity
            android:name=".LibraryActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/menu_settings"
            android:parentActivityName=".LibraryActivity" />

        <activity
            android:name=".EmulatorActivity"
            android:theme="@style/AppTheme.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="fullUser" />
    </application>
</manifest>
