/* ---------------- navegador de arquivos NATIVO ----------------
   O AknCommonDialogs mostra primeiro a escolha de memoria (telefone / cartao) e
   depois o navegador de pastas do proprio sistema -- o mesmo do Gestor de
   Arquivos do aparelho. */
RESOURCE MEMORYSELECTIONDIALOG r_wolphun_memory_selection
{
    title     = "Look in:";
    softkey_1 = "Select";
    softkey_2 = "Cancel";
    locations =
    {
        LOCATION { root_path = "C:\\"; },
        LOCATION { root_path = "E:\\"; }
    };
}

/* Navegador de arquivos: titulo + FILTRO declarativo (.mpn). O filtro inclusivo faz o
   dialogo mostrar so as pastas e os arquivos .mpn -- sem ele o usuario veria o cartao
   de memoria inteiro. */
RESOURCE FILESELECTIONDIALOG r_wolphun_file_selection
{
    title                 = "Choose an .mpn file";
    softkey_1_file        = "Open";
    softkey_1_folder      = "Open";
    softkey_2_root_level  = "Cancel";
    softkey_2_subfolder   = "Back";
    filters =
    {
        FILTER
        {
            filter_type  = EFilenameFilter;
            filter_style = EInclusiveFilter;
            filter_data  = { "*.mpn" };
        }
    };
}

/* ---------------- lista de pastas cadastradas ---------------- */
RESOURCE DIALOG r_wolphun_keys_list
{
    flags   = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_SELECT_CANCEL;
    items =
    {
        DLG_LINE
        {
            type = EAknCtListQueryControl;
            id   = EListQueryControl;
            control = AVKON_LIST_QUERY_CONTROL
            {
                listtype = EAknCtSinglePopupMenuListBox;
                listbox = LISTBOX { flags = EAknListBoxSelectionList; array_id = r_wolphun_empty_items; };
                heading  = "Edit keys";
            };
        }
    };
}

RESOURCE DIALOG r_wolphun_folder_list
{
    flags   = EGeneralQueryFlags;
