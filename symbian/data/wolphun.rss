/* ---------------- listas de configuracao ----------------
   Uma lista de consulta nativa por configuracao. (Antes isto usava
   CAknRadioButtonSettingPage com R_AVKON_DEFAULT_SETTING_PAGE -- mas esse recurso tem
   type=0xffff e editor_resource_id=0, ou seja NAO e uma pagina com listbox, e o
   aplicativo fechava ao abrir. A lista de consulta e o mesmo widget da lista de jogos:
   simples, nativo e confirmado com a tecla do meio.) */
RESOURCE DIALOG r_wolphun_choice_resolution
{
    flags = EGeneralQueryFlags;
    buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
    items =
    {
        DLG_LINE { type = EAknCtListQueryControl; id = EListQueryControl;
            control = AVKON_LIST_QUERY_CONTROL
            { listtype = EAknCtSinglePopupMenuListBox; listbox = LISTBOX { flags = EAknListBoxSelectionList; array_id = r_wolphun_resolution_items; }; heading = "Game resolution"; }; }
    };
}
