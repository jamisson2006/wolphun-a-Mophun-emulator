/* wolphun.rss - recursos de UI do emulador (S60 3rd Edition / Avkon).
 *
 * A softkey ESQUERDA e "Opcoes" (R_AVKON_SOFTKEYS_OPTIONS_EXIT): ao apertar, o Avkon
 * abre este menu com a aparencia NATIVA do sistema. Todas as configuracoes sao listas
 * do proprio sistema (menu pane + setting page de radio), nenhuma UI desenhada a mao.
 */
NAME WLPH

#include <eikon.rh>
#include <avkon.rh>
#include <avkon.rsg>
#include <avkon.mbg>
#include <appinfo.rh>
#include <CommonDialogs.rh>     /* navegador de arquivos NATIVO do sistema */
#include <CommonDialogs.hrh>
#include "wolphun.hrh"

RESOURCE RSS_SIGNATURE { }

RESOURCE TBUF r_default_document_name { buf = ""; }

RESOURCE EIK_APP_INFO
{
    menubar = r_wolphun_menubar;
    cba     = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
}

/* ---------------- menu da softkey esquerda ---------------- */
RESOURCE MENU_BAR r_wolphun_menubar
{
    titles =
    {
        MENU_TITLE { menu_pane = r_wolphun_menu; }
    };
}

RESOURCE MENU_PANE r_wolphun_menu
{
    items =
    {
        MENU_ITEM { command = EWolphunCmdOpenRom;    txt = "Open game"; },
        MENU_ITEM { command = EWolphunCmdBrowseFile; txt = "Browse file..."; },
        MENU_ITEM { command = EWolphunCmdFolders;    txt = "Game folders";
                    cascade = r_wolphun_folders_menu; },
        MENU_ITEM { command = EWolphunCmdRestart;  txt = "Restart game"; },
        MENU_ITEM { command = EWolphunCmdCloseRom; txt = "Close game"; },
        MENU_ITEM { command = EWolphunCmdSettings; txt = "Settings";
                    cascade = r_wolphun_settings_menu; },
        MENU_ITEM { command = EWolphunCmdAbout;    txt = "About"; },
        MENU_ITEM { command = EAknSoftkeyExit;     txt = "Exit"; }
    };
}

/* Submenu das pastas de jogos: o usuario cadastra quantas quiser (bulk) e o
   "Open game" varre TODAS de uma vez. */
RESOURCE MENU_PANE r_wolphun_folders_menu
{
    items =
    {
        MENU_ITEM { command = EWolphunCmdAddFolder;    txt = "Add folder..."; },
        MENU_ITEM { command = EWolphunCmdRemoveFolder; txt = "Remove folder..."; }
    };
}

/* Submenu de configuracoes - cada item abre uma LISTA nativa do sistema */
RESOURCE MENU_PANE r_wolphun_settings_menu
{
    items =
    {
        MENU_ITEM { command = EWolphunCmdSetResolution; txt = "Game resolution"; },
        MENU_ITEM { command = EWolphunCmdSetScaling;    txt = "Screen fit"; },
        MENU_ITEM { command = EWolphunCmdSetKeyProfile; txt = "Controls"; },
        MENU_ITEM { command = EWolphunCmdEditKeys;     txt = "Edit keys"; },
        MENU_ITEM { command = EWolphunCmdSetSound;      txt = "Sound"; },
        MENU_ITEM { command = EWolphunCmdSetTexFilter;  txt = "Texture filter (3D)"; },
        MENU_ITEM { command = EWolphunCmdSetPowerSave;  txt = "Battery saving"; },
        MENU_ITEM { command = EWolphunCmdSetLanguage;   txt = "Language"; },
        MENU_ITEM { command = EWolphunCmdFullscreen;    txt = "Fullscreen"; },
        MENU_ITEM { command = EWolphunCmdSetFullKey;    txt = "Fullscreen key"; },
        MENU_ITEM { command = EWolphunCmdSetVibrate;    txt = "Vibration"; }
    };
}

